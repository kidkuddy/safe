#!/usr/bin/env python3
"""safe - keep media folders in a private R2 bucket and browse them on the web.

  ./safe ls                         what is tracked, how big, how much is uploaded
  ./safe add <path>... [--title T]  track a folder or file as its own resource
  ./safe rm <id> [--purge]          stop tracking (--purge also deletes it from the bucket)
  ./safe push [id...] [--jobs N]    convert where needed, upload N files at once (default 4), verify, refresh the site
  ./safe check <id>                 health check: every file present, every video opens with the right length
  ./safe pull <id> [dest]           download a resource back from the bucket
  ./safe selftest

Resources live in resources.json, the bucket and endpoint in config.json. The R2 key is read from the
macOS keychain (service "safe-r2").
"""
import argparse, hashlib, json, os, re, subprocess, sys, tempfile, time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HOME, HERE = Path.home(), Path(__file__).resolve().parent
KEYCHAIN = "safe-r2"
CONF_F = HERE / "config.json"
if not CONF_F.exists():
    sys.exit("config.json is missing. Copy config.example.json to config.json and fill in your bucket and R2 endpoint.")
CONF = json.loads(CONF_F.read_text())
BUCKET, ENDPOINT = CONF["bucket"], CONF["endpoint"]  # endpoint: https://<account-id>.r2.cloudflarestorage.com
RES_F, STATE_F = HERE / "resources.json", HERE / "state.json"
VIDEO = {".mp4", ".mkv", ".m4v", ".mov", ".webm", ".avi", ".ts"}  # .ts: MPEG transport stream; a TypeScript file just fails the probe
MP4ISH = {".mp4", ".m4v", ".mov"}
TEXT_SUBS = {"subrip", "ass", "ssa", "mov_text", "webvtt"}
KEY_HELP = f"""No R2 key in the keychain. Create one in the Cloudflare dashboard (R2 -> Manage API tokens ->
Object Read & Write, bucket "{BUCKET}" only), then run these in a terminal; each prompts for the value:
  security add-generic-password -U -s {KEYCHAIN} -a access-key-id -w
  security add-generic-password -U -s {KEYCHAIN} -a secret-access-key -w"""


# ---------- small pure helpers ----------

def natural(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]


def slug(s):
    s = re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", s)  # drop [release tags] and (notes)
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:40].strip("-")


def gb(n):
    return f"{n / 1e9:.1f} GB" if n >= 1e8 else f"{n / 1e6:.0f} MB"


def sha256(f):
    h = hashlib.sha256()
    with open(f, "rb") as fh:
        while b := fh.read(1 << 22):
            h.update(b)
    return h.hexdigest()


def faststart(f):
    """True when the mp4 index (moov) comes before the media data, so a browser can seek without reading the whole file."""
    with open(f, "rb") as fh:
        pos = 0
        while True:
            fh.seek(pos)
            h = fh.read(16)
            if len(h) < 8:
                return True
            size, typ = int.from_bytes(h[:4], "big"), h[4:8]
            if size == 1:
                size = int.from_bytes(h[8:16], "big")
            if typ == b"moov":
                return True
            if typ == b"mdat":
                return False
            if size < 8:
                return True
            pos += size


def bend(b, i):
    """Index just past the bencoded value starting at i."""
    c = b[i:i + 1]
    if c == b"i":
        return b.index(b"e", i) + 1
    if c in (b"l", b"d"):
        i += 1
        while b[i:i + 1] != b"e":
            i = bend(b, i)
        return i + 1
    colon = b.index(b":", i)
    return colon + 1 + int(b[i:colon])


def infohash(b):
    """BitTorrent v1 infohash of a .torrent file's bytes."""
    i = 1
    while b[i:i + 1] != b"e":
        kend = bend(b, i)
        key, vend = b[b.index(b":", i) + 1:kend], bend(b, kend)
        if key == b"info":
            return hashlib.sha1(b[kend:vend]).hexdigest()
        i = vend


# ---------- resources and scanning ----------

def load_resources():
    return json.loads(RES_F.read_text()) if RES_F.exists() else []


def save_resources(rs):
    RES_F.write_text(json.dumps(rs, indent=2, ensure_ascii=False) + "\n")


def path_of(r):
    return Path(r["path"]).expanduser()


def probe(f):
    r = subprocess.run(["ffprobe", "-v", "error", "-show_streams", "-show_format", "-of", "json", str(f)],
                       capture_output=True, text=True)
    try:
        j = json.loads(r.stdout)
    except ValueError:
        j = {}
    ss = j.get("streams", [])
    v = next((s for s in ss if s.get("codec_type") == "video" and not s.get("disposition", {}).get("attached_pic")), None)
    a = next((s for s in ss if s.get("codec_type") == "audio"), None)
    subs = [s for s in ss if s.get("codec_type") == "subtitle" and s.get("codec_name") in TEXT_SUBS]
    sub = next((s for s in subs if s.get("tags", {}).get("language") in ("eng", "en")), subs[0] if subs else None)
    # what every current browser plays without re-encoding: 8-bit H.264 with AAC/MP3 audio
    ok = bool(v) and v.get("codec_name") == "h264" and v.get("pix_fmt") in ("yuv420p", "yuvj420p") \
        and (a is None or a.get("codec_name") in ("aac", "mp3"))
    return dict(ok=ok, v=v["index"] if v else None, a=a["index"] if a else None, sub=sub["index"] if sub else None,
                dur=round(float(j.get("format", {}).get("duration") or 0)))


def gather(r):
    """[(file, rel path inside the resource)]"""
    root = path_of(r)
    if root.is_file():
        return [(root, root.name)]
    out = [(f, str(f.relative_to(root))) for f in root.rglob("*") if f.is_file()]
    for e in map(lambda p: Path(p).expanduser(), r.get("extras", [])):
        out += [(f, "_source/" + str(f.relative_to(e))) for f in e.rglob("*") if f.is_file()]
    out = [(f, rel) for f, rel in out if not any(p.startswith(".") for p in Path(rel).parts)]
    return sorted(out, key=lambda x: natural(x[1]))


def plan(r, state):
    files = gather(r)
    have = {str(f) for f, _ in files}
    items = []
    for f, rel in files:
        ext = f.suffix.lower()
        if ext == ".srt" and any(str(f.with_suffix(e)) in have for e in VIDEO):
            continue  # becomes the .vtt track of its video
        s, st = f.stat(), state.get(str(f), {})
        if st.get("size") != s.st_size or st.get("mtime") != s.st_mtime:
            st = dict(size=s.st_size, mtime=s.st_mtime, sha256=sha256(f))
            if ext in VIDEO:
                st["probe"] = probe(f)
                st["fast"] = ext not in MP4ISH or faststart(f)
            state[str(f)] = st
        it = dict(rel=rel, key=f"{r['id']}/{rel}", size=st["size"], sha256=st["sha256"], play=False, _src=f)
        if ext == ".torrent":
            it["magnet"] = f"magnet:?xt=urn:btih:{infohash(f.read_bytes())}"
        if ext in VIDEO:
            p = st["probe"]
            it["dur"] = p["dur"]
            if p["ok"]:
                it["play"] = True
                if ext not in MP4ISH or not st["fast"]:
                    it["_fix"] = p
                    it["fixed"] = True  # repackaged copy in the bucket, so its size differs from the local file
                    it["key"] = str(Path(it["key"]).with_suffix(".mp4"))
                srt = f.with_suffix(".srt")
                if srt.exists():
                    it["_sub"] = (srt, None)
                elif p["sub"] is not None:
                    it["_sub"] = (f, p["sub"])
                if "_sub" in it:
                    it["sub"] = str(Path(it["key"]).with_suffix(".vtt"))
        items.append(it)
    return items


def scan(resources):
    state = json.loads(STATE_F.read_text()) if STATE_F.exists() else {}
    out = []
    mf = HERE / "manifest.json"
    old = {x["id"]: x["items"] for x in json.loads(mf.read_text())["resources"]} if mf.exists() else {}
    for r in resources:
        if not path_of(r).exists():
            if r["id"] in old:  # local copy deleted after upload: the bucket record stands in for it
                out.append((r, [dict(i, _gone=True) for i in old[r["id"]]]))
            else:
                print(f"  ! {r['id']}: not on this disk and never uploaded ({r['path']})")
            continue
        new = sum(1 for f, _ in gather(r) if str(f) not in state and f.suffix.lower() != ".srt")
        if new:
            print(f"  reading {r['id']} ({new} new files) ...", flush=True)
        out.append((r, plan(r, state)))
        STATE_F.write_text(json.dumps(state))
    return out


# ---------- R2 ----------

_env = None


def env(required=True):
    global _env
    if _env is None:
        vals = {}
        for a in ("access-key-id", "secret-access-key"):
            p = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN, "-a", a, "-w"],
                               capture_output=True, text=True)
            if p.returncode:
                if required:
                    sys.exit(KEY_HELP)
                return None
            vals[a] = p.stdout.strip()
        # Cloudflare's S3 secret is the SHA-256 of the API token value, so accept the raw token too
        if not re.fullmatch(r"[0-9a-f]{64}", vals["secret-access-key"]):
            vals["secret-access-key"] = hashlib.sha256(vals["secret-access-key"].encode()).hexdigest()
        _env = {k: v for k, v in os.environ.items() if k != "AWS_PROFILE"} | {
            "AWS_ACCESS_KEY_ID": vals["access-key-id"], "AWS_SECRET_ACCESS_KEY": vals["secret-access-key"],
            "AWS_DEFAULT_REGION": "auto",
            # R2 does not accept the extra checksums newer aws CLIs add by default
            "AWS_REQUEST_CHECKSUM_CALCULATION": "when_required", "AWS_RESPONSE_CHECKSUM_VALIDATION": "when_required"}
    return _env


def aws(*a, show=False, tries=1):
    """tries > 1 waits 10s, 30s, 90s, 270s, 300s... between attempts, to ride out a network drop."""
    for n in range(tries):
        p = subprocess.run(["aws", "--endpoint-url", ENDPOINT, *a], env=env(), text=True,
                           stdout=None if show else subprocess.PIPE, stderr=None if show else subprocess.PIPE)
        if not p.returncode:
            return p.stdout
        if n < tries - 1:
            time.sleep(min(300, 10 * 3 ** n))
    raise RuntimeError((p.stderr or "aws failed").strip())


def remote_listing(required=True):
    if env(required) is None:
        return None
    out = aws("s3api", "list-objects-v2", "--bucket", BUCKET, "--output", "json", tries=7)
    return {o["Key"]: o["Size"] for o in (json.loads(out).get("Contents") or [])} if out.strip() else {}


def s3cp(src, key, ctype=None):
    """Upload, then read the size back. `aws s3 cp` has exited 0 without the object existing when the
    network dropped (seen 2026-11-15), so only the read-back counts. 5 attempts, waiting 20s to 9 min between."""
    want, err = Path(src).stat().st_size, ""
    for n in range(5):
        try:
            aws("s3", "cp", str(src), f"s3://{BUCKET}/{key}", "--only-show-errors",
                *(["--content-type", ctype] if ctype else []))
            got = json.loads(aws("s3api", "head-object", "--bucket", BUCKET, "--key", key, "--output", "json"))["ContentLength"]
            if got == want:
                return
            err = f"bucket has {got} bytes, expected {want}"
        except RuntimeError as e:
            err = str(e)
        if n < 4:
            time.sleep(20 * 3 ** n)
    raise RuntimeError(f"gave up after 5 attempts: {err}")


def ffmpeg(*a):
    subprocess.run(["ffmpeg", "-v", "error", "-y", *map(str, a)], check=True)


def push_item(it, remote, tmp):
    if it["key"] not in remote:
        src = it["_src"]
        if "_fix" in it:
            p, out = it["_fix"], tmp / "v.mp4"
            try:  # repackage only, no re-encode
                ffmpeg("-i", src, "-map", f"0:{p['v']}", *(["-map", f"0:{p['a']}"] if p["a"] is not None else []),
                       "-c", "copy", "-movflags", "+faststart", out)
                src = out
            except subprocess.CalledProcessError:
                print("      could not repackage; uploading as download-only")
                it.update(play=False, key=it["key"].rsplit("/", 1)[0] + "/" + it["_src"].name)
                it.pop("sub", None)
                it.pop("fixed", None)
        s3cp(src, it["key"], "video/mp4" if it["key"].endswith(".mp4") else None)
    if it.get("sub") and it["sub"] not in remote:
        src, idx = it["_sub"]
        try:
            ffmpeg("-i", src, *(["-map", f"0:{idx}"] if idx is not None else []), tmp / "s.vtt")
            s3cp(tmp / "s.vtt", it["sub"], "text/vtt")
        except subprocess.CalledProcessError:
            print("      subtitle conversion failed; skipping subtitles")
            it.pop("sub")


def missing(items, remote):
    """Items not in the bucket, or in it with a size that differs from the untouched local file."""
    out = []
    for it in items:
        it["up"] = remote is not None and it["key"] in remote
        same_file = not it.get("fixed")  # not repackaged, so sizes must match exactly
        if not it["up"] or (same_file and remote[it["key"]] != it["size"]):
            out.append(it)
    return out


# ---------- outputs ----------

def readme(cols):
    L = ["# safe - media archive", "",
         f"Generated {time.strftime('%Y-%m-%d')} by `safe`. Files live in the Cloudflare R2 bucket `{BUCKET}`, served by",
         "the Worker in `worker.js`. `manifest.json` (next to this file and in the bucket) lists every file with its",
         "size and the SHA-256 of the original, so a re-downloaded copy can be checked against it.", "",
         "## Get the files back from the bucket", "", "```", "./safe pull <id> [destination]", "```", "",
         "## If the bucket is gone: where each resource came from", ""]
    for r, items in cols:
        p = path_of(r)
        L += [f"### {r['title']}", "", f"- id / bucket prefix: `{r['id']}/`",
              f"- Original name (search for this): `{p.name}`", f"- Was stored at: `{r['path']}`",
              f"- Files: {len(items)}, {gb(sum(i['size'] for i in items))}",
              f"- Source: {r.get('source') or '**TODO - fill in `source` in resources.json**'}"]
        for it in items:
            if it["rel"].lower().endswith(".torrent"):
                L.append(f"- Torrent `{it['rel']}` (also in the bucket): `{it.get('magnet', '')}`")
        L.append("")
    return "\n".join(L)


def write_outputs(cols):
    (HERE / "ARCHIVE.md").write_text(readme(cols))
    manifest = dict(generated=time.strftime("%Y-%m-%d %H:%M"), resources=[
        dict(id=r["id"], title=r["title"], items=[{k: v for k, v in it.items() if not k.startswith("_")} for it in items])
        for r, items in cols])
    (HERE / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False))


def table(cols, remote):
    w = max([len(r["id"]) for r, _ in cols] + [2])
    print(f"\n  {'ID':<{w}}  {'FILES':>5}  {'SIZE':>8}  {'PLAYABLE':>8}  {'UPLOADED':>9}  {'STATUS':<30} TITLE")
    tot = 0
    for r, items in cols:
        miss = len(missing(items, remote))
        up = "?" if remote is None else f"{len(items) - miss}/{len(items)}"
        gone = any(i.get("_gone") for i in items)
        status = "" if remote is None else "verified" if not miss else "incomplete"
        status += ", local copy deleted" if gone else ""
        size = sum(i["size"] for i in items)
        tot += size
        print(f"  {r['id']:<{w}}  {len(items):>5}  {gb(size):>8}  {sum(i['play'] for i in items):>8}  {up:>9}  {status:<30} {r['title']}")
    print(f"\n  total {gb(tot)}, about ${max(0, tot / 1e9 - 10) * 0.015:.2f}/month on R2"
          + ("" if remote is not None else "   (UPLOADED unknown: no R2 key in the keychain yet)"))


# ---------- commands ----------

def cmd_ls(a):
    cols = scan(load_resources())
    remote = remote_listing(required=False)
    table(cols, remote)
    write_outputs(cols)


def cmd_add(a):
    rs = load_resources()
    if (a.id or a.title) and len(a.paths) > 1:
        sys.exit("--id and --title only work with a single path")
    for p in a.paths:
        p = Path(p).expanduser().resolve()
        if not p.exists():
            sys.exit(f"not found: {p}")
        name = p.stem if p.is_file() else p.name
        rid = a.id or slug(name)
        if not rid or any(r["id"] == rid for r in rs):
            sys.exit(f"id '{rid}' is empty or already used; pass --id")
        title = a.title or re.sub(r"\s+", " ", re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", name)).strip() or name
        rs.append(dict(id=rid, title=title, path=str(p).replace(str(HOME), "~"), source=""))
        print(f"added {rid}: {title}")
    save_resources(rs)
    print("run ./safe push to upload")


def cmd_rm(a):
    rs = load_resources()
    if not any(r["id"] == a.id for r in rs):
        sys.exit(f"no resource '{a.id}'. Known: {', '.join(r['id'] for r in rs)}")
    if a.purge:
        aws("s3", "rm", f"s3://{BUCKET}/{a.id}/", "--recursive", "--only-show-errors")
        print(f"deleted {a.id}/ from the bucket")
    save_resources([r for r in rs if r["id"] != a.id])
    print(f"stopped tracking {a.id} (local files untouched" + ("" if a.purge else "; bucket copy, if any, kept") + ")")
    if a.purge:
        cmd_push(argparse.Namespace(ids=["-"], jobs=1))  # refresh the site's manifest without uploading anything


def notify(title, msg):
    """macOS notification; arguments are passed as data, not spliced into the script."""
    subprocess.run(["osascript", "-e", "on run a", "-e",
                    'display notification (item 2 of a) with title (item 1 of a) sound name "Glass"', "-e", "end run",
                    title, msg], capture_output=True)


def publish(cols, remote):
    for _, items in cols:
        missing(items, remote)  # sets the "up" flag the site reads
    write_outputs(cols)
    for name, ct in (("manifest.json", "application/json"), ("ARCHIVE.md", "text/markdown; charset=utf-8"),
                     ("index.html", "text/html; charset=utf-8")):
        s3cp(HERE / name, name, ct)


def cmd_push(a):
    cols = scan(load_resources())
    by_id = {r["id"]: (r, items) for r, items in cols}
    if bad := [i for i in a.ids if i not in by_id and i != "-"]:
        sys.exit(f"unknown id(s): {', '.join(bad)}. Known: {', '.join(by_id)}")
    remote = remote_listing()
    need = lambda items: [i for i in items if "_src" in i
                          and (i["key"] not in remote or (i.get("sub") and i["sub"] not in remote))]
    # no ids given: least remaining first, so finished resources show up (and can be deleted locally) early
    order = [by_id[i] for i in a.ids if i != "-"] if a.ids else sorted(cols, key=lambda c: sum(i["size"] for i in need(c[1])))
    incomplete = 0
    for r, items in order:
        todo = need(items)
        total, t0, sent = sum(i["size"] for i in todo), time.time(), [0, 0]
        print(f"\n== {r['id']}: {len(todo)} of {len(items)} files to upload ({gb(total)})", flush=True)

        def one(it):
            with tempfile.TemporaryDirectory(dir=HERE) as d:  # one scratch folder per worker
                try:
                    push_item(it, remote, Path(d))
                    err = ""
                except RuntimeError as e:
                    err = f"  FAILED: {str(e)[:200]}"
            sent[0] += 1
            sent[1] += it["size"]
            rate = sent[1] / max(1, time.time() - t0)
            print(f"  [{sent[0]}/{len(todo)}] {gb(sent[1])} of {gb(total)}, {rate * 8 / 1e6:.0f} Mbps, "
                  f"~{(total - sent[1]) / rate / 3600:.1f} h left  {it['rel']}{err}", flush=True)

        if todo:
            with ThreadPoolExecutor(a.jobs) as pool:
                list(pool.map(one, todo))
            remote = remote_listing()
        publish(cols, remote)
        miss = missing(items, remote)
        if miss:
            incomplete += 1
            print(f"   INCOMPLETE {r['id']}: {len(miss)} files missing or wrong size (run ./safe push {r['id']} again):")
            for it in miss[:10]:
                print(f"      {it['rel']}")
            notify(f"safe: {r['title']} incomplete", f"{len(miss)} files missing. Run ./safe push {r['id']} again.")
        else:
            print(f"   VERIFIED {r['id']}: all {len(items)} files are in the bucket with matching sizes and on the site."
                  f"\n   Local copy can be deleted: {r['path']}", flush=True)
            if todo:
                notify(f"safe: {r['title']} is uploaded", f"All {len(items)} files verified. Ready to check on the site.")
    if not order:
        publish(cols, remote)
    table(cols, remote)
    sys.exit(1 if incomplete else 0)


def cmd_check(a):
    """Health check against the bucket: every file present with the right size, every video opens and has the right length."""
    by_id = {r["id"]: items for r, items in scan(load_resources())}
    if a.id not in by_id:
        sys.exit(f"no resource '{a.id}'. Known: {', '.join(by_id)}")
    remote, items = remote_listing(), by_id[a.id]

    def one(it):
        if it["key"] not in remote:
            return f"missing: {it['rel']}"
        if not it.get("fixed") and remote[it["key"]] != it["size"]:
            return f"wrong size ({remote[it['key']]} vs {it['size']}): {it['rel']}"
        if it.get("sub") and it["sub"] not in remote:
            return f"subtitles missing: {it['rel']}"
        if it["play"]:  # read the video's header straight from the bucket
            url = aws("s3", "presign", f"s3://{BUCKET}/{it['key']}", "--expires-in", "900", tries=3).strip()
            p = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration:stream=codec_name", "-of", "json", url],
                               capture_output=True, text=True, timeout=120)
            try:
                j = json.loads(p.stdout)
                dur, codecs = float(j["format"]["duration"]), [x.get("codec_name") for x in j["streams"]]
            except (ValueError, KeyError):
                return f"does not open as a video: {it['rel']}"
            if abs(dur - it["dur"]) > 2 or "h264" not in codecs:
                return f"opens but looks wrong (length {dur:.0f}s vs {it['dur']}s, {codecs}): {it['rel']}"
        return None

    with ThreadPoolExecutor(8) as pool:
        bad = [b for b in pool.map(one, items) if b]
    vids = sum(i["play"] for i in items)
    print(f"{a.id}: {len(items)} files checked for presence and size, {vids} videos opened from the bucket and length compared")
    for b in bad:
        print("  PROBLEM " + b)
    print("  healthy" if not bad else f"  {len(bad)} problems")
    sys.exit(1 if bad else 0)


def cmd_pull(a):
    dest = a.dest or f"./{a.id}"
    aws("s3", "sync", f"s3://{BUCKET}/{a.id}/", dest, show=True)
    print(f"downloaded to {dest}")


def cmd_selftest(a):
    info = b"d4:name1:ae"
    assert infohash(b"d8:announce3:url4:info" + info + b"e") == hashlib.sha1(info).hexdigest()
    atom = lambda t, n: (8 + n).to_bytes(4, "big") + t + b"\0" * n
    with tempfile.TemporaryDirectory() as d:
        x, y = Path(d) / "a", Path(d) / "b"
        x.write_bytes(atom(b"ftyp", 4) + atom(b"moov", 9) + atom(b"mdat", 9))
        y.write_bytes(atom(b"ftyp", 4) + atom(b"mdat", 9) + atom(b"moov", 9))
        assert faststart(x) and not faststart(y)
    assert sorted(["10. x", "2. x", "1. x"], key=natural) == ["1. x", "2. x", "10. x"]
    assert slug("[Group] Some Show - Batch [BD][720p]") == "some-show-batch"
    print("selftest ok")


def main():
    ap = argparse.ArgumentParser(prog="safe", description=__doc__.split("\n\n")[0],
                                 epilog=__doc__.split("\n\n", 1)[1], formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="command")
    sub.add_parser("ls", help="list tracked resources").set_defaults(f=cmd_ls)
    p = sub.add_parser("add", help="track a folder or file"); p.set_defaults(f=cmd_add)
    p.add_argument("paths", nargs="+"); p.add_argument("--id"); p.add_argument("--title")
    p = sub.add_parser("rm", help="stop tracking a resource"); p.set_defaults(f=cmd_rm)
    p.add_argument("id"); p.add_argument("--purge", action="store_true", help="also delete it from the bucket")
    p = sub.add_parser("push", help="upload and verify"); p.set_defaults(f=cmd_push)
    p.add_argument("ids", nargs="*"); p.add_argument("--jobs", type=int, default=4, help="files uploaded at once (default 4)")
    p = sub.add_parser("check", help="health-check one resource in the bucket"); p.set_defaults(f=cmd_check)
    p.add_argument("id")
    p = sub.add_parser("pull", help="download a resource back"); p.set_defaults(f=cmd_pull)
    p.add_argument("id"); p.add_argument("dest", nargs="?")
    sub.add_parser("selftest", help="check the helpers").set_defaults(f=cmd_selftest)
    a = ap.parse_args()
    try:
        a.f(a)
    except RuntimeError as e:
        sys.exit(f"error: {e}")


if __name__ == "__main__":
    main()
